---
pagination:
  data: demos
  size: 1
  alias: demo
permalink: "/demo/{{ demo.slug }}/index.html"
eleventyExcludeFromCollections: true
---
{#-
  Generic AI-visibility demo template — one page per demos/{slug}.json config.
  Adding a prospect = adding one config file; this template carries zero
  client-specific strings. The live tester reuses the same /demo/probe proxy
  (netlify.toml → Render ai-visibility-engine) as the original demo page, so no API keys
  ever reach the client. Sections, in conversion order: hero+ticker · explainer
  video · live test (email gate at the reveal) · MAXIFI calculator · proof ·
  ladder · method note · final dual CTA.
-#}
<!doctype html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ demo.client_name }} — what AI tells your buyers, live · Maxifi Digital</title>
<meta name="description" content="Live AI-visibility demonstration for {{ demo.client_name }}: see word-for-word what ChatGPT, Claude, Gemini, Perplexity and Google AI Overviews tell buyers — and what that visibility is worth.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&display=swap">
<style>
  /* ── House style: Inter · blue #1D4ED8 · ink #16181D · off-white #FBFAF6 ── */
  :root{
    --sans:"Inter",-apple-system,BlinkMacSystemFont,"Segoe UI",system-ui,sans-serif;
    --primary:#1D4ED8; --primary-hover:#1E40AF; --primary-active:#1E3A8A; --on-primary:#ffffff;
    --canvas:#FBFAF6; --layer:#ffffff; --field:#ffffff;
    --hairline:#E7E4DC; --border-strong:#CFCBC0;
    --ink:#16181D; --ink-muted:#4B4F58; --ink-subtle:#71757E; --placeholder:#A5A8AF;
    --error:#B42318; --dark:#16181D; --container:1056px;
    --cited-fg:#0e6027; --cited-bg:#d9f0e0;
    --partial-fg:#7d4e00; --partial-bg:#fdf0cd;
    --missing-fg:#7a1521; --missing-bg:#fbdcde;
  }
  *{box-sizing:border-box}
  [hidden]{display:none!important}   /* keep `hidden` winning over display:flex/grid rules */
  html{scroll-behavior:smooth}
  body{margin:0;background:var(--canvas);color:var(--ink);font-family:var(--sans);
    font-size:16px;line-height:1.5;-webkit-font-smoothing:antialiased;font-weight:300}
  a{color:inherit}
  .mx-container{max-width:var(--container);margin:0 auto;padding:0 32px}
  @media(max-width:680px){.mx-container{padding:0 20px}}
  .mx-section{padding:56px 0}
  .mx-eyebrow{font-size:11px;letter-spacing:.48px;text-transform:uppercase;color:var(--primary);
    font-weight:600;display:flex;align-items:center}
  .mx-acc-line{display:inline-block;width:24px;height:1px;background:var(--primary);margin-right:12px}
  .mx-display{font-weight:300;font-size:clamp(34px,5.4vw,60px);line-height:1.06;letter-spacing:-.02em;margin:0}
  .mx-h2{font-weight:300;font-size:clamp(26px,3.2vw,40px);line-height:1.12;letter-spacing:-.012em;margin:0}
  .mx-italic{font-style:italic}
  .mx-body{font-size:16px;line-height:1.55;color:var(--ink-muted)}
  .mx-meta{font-size:12px;letter-spacing:.02em;color:var(--ink-subtle);text-transform:uppercase}
  .mx-num{font-variant-numeric:tabular-nums}
  .mx-btn{display:inline-flex;align-items:center;gap:10px;font-size:14px;font-weight:400;
    padding:13px 20px;border-radius:0;border:1px solid transparent;background:var(--primary);
    color:var(--on-primary);cursor:pointer;text-decoration:none;white-space:nowrap;
    transition:background 240ms cubic-bezier(.2,.6,.3,1)}
  .mx-btn:hover{background:var(--primary-hover)}
  .mx-btn:active{background:var(--primary-active)}
  .mx-btn.is-secondary{background:transparent;color:var(--primary);border-color:var(--primary)}
  .mx-btn.is-secondary:hover{background:rgba(29,78,216,.08)}
  .mx-btn.is-on-dark{background:#fff;color:var(--primary)}
  .mx-btn.is-sm{padding:9px 16px;font-size:13px}
  .mx-btn:disabled{opacity:.6;cursor:not-allowed}
  .mx-card{background:var(--layer);border:1px solid var(--hairline);border-radius:0;padding:24px}
  .cta-row{display:flex;gap:12px;flex-wrap:wrap}
  /* header — sticky, with site-wide booking CTA */
  .c-header{position:sticky;top:0;z-index:50;background:rgba(251,250,246,.92);
    backdrop-filter:saturate(140%) blur(12px);-webkit-backdrop-filter:saturate(140%) blur(12px);
    border-bottom:1px solid var(--hairline)}
  .c-header .bar{display:flex;align-items:center;justify-content:space-between;padding:12px 0;gap:12px}
  .mx-logo img{display:block;height:40px;width:auto}
  /* ticker */
  .ticker{display:flex;align-items:stretch;overflow:hidden;background:var(--layer);
    border-bottom:1px solid var(--hairline)}
  .ticker-tag{flex:none;display:inline-flex;align-items:center;gap:9px;background:var(--ink);color:#fff;
    font-size:11px;font-weight:300;letter-spacing:.5px;text-transform:uppercase;padding:0 18px;white-space:nowrap}
  .ticker-dot{width:7px;height:7px;border-radius:50%;background:#42be65;animation:tkPulse 2s ease-out infinite}
  .ticker-viewport{position:relative;flex:1;overflow:hidden;
    -webkit-mask-image:linear-gradient(90deg,transparent,#000 5%,#000 95%,transparent);
    mask-image:linear-gradient(90deg,transparent,#000 5%,#000 95%,transparent)}
  .ticker-track{display:inline-flex;align-items:center;white-space:nowrap;padding:9px 0;
    will-change:transform;animation:tickerScroll 46s linear infinite}
  .ticker:hover .ticker-track{animation-play-state:paused}
  .tk-set{display:inline-flex;align-items:center}
  .ticker-item{display:inline-flex;align-items:center;gap:10px;font-size:12.5px;color:var(--ink-muted);
    padding:0 6px;white-space:nowrap}
  .ticker-item .tk-q{font-style:italic}
  .ticker-item .tk-cite{display:inline-flex;align-items:center;gap:5px;color:#0e6027;letter-spacing:.2px}
  .ticker-item .tk-miss{display:inline-flex;align-items:center;gap:5px;color:var(--missing-fg);letter-spacing:.2px}
  .ticker-sep{color:var(--border-strong);font-size:8px;padding:0 16px}
  @keyframes tickerScroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}
  @keyframes tkPulse{0%{box-shadow:0 0 0 0 rgba(66,190,101,.5)}70%,100%{box-shadow:0 0 0 6px rgba(66,190,101,0)}}
  /* hero */
  .hero{position:relative;overflow:hidden;padding:48px 0 54px}
  .hero-glow{position:absolute;top:-160px;right:-120px;width:460px;height:460px;border-radius:50%;
    background:radial-gradient(closest-side,rgba(29,78,216,.08),transparent 70%);pointer-events:none}
  .sector-chip{display:inline-block;font-size:11px;letter-spacing:.06em;text-transform:uppercase;
    color:var(--ink-muted);border:1px solid var(--hairline);background:var(--layer);padding:5px 10px;margin-bottom:18px}
  /* video */
  .video-shell{margin-top:30px;position:relative;background:var(--dark);border:1px solid var(--hairline);
    aspect-ratio:16/9;max-width:880px}
  .video-shell iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
  .video-poster{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;
    justify-content:center;gap:14px;color:#fff;text-align:center;padding:24px;cursor:pointer;border:0;
    background:radial-gradient(closest-side at 50% 40%,rgba(29,78,216,.35),rgba(22,24,29,.97));width:100%}
  .video-poster .play{width:64px;height:64px;border-radius:50%;background:#fff;color:var(--primary);
    display:flex;align-items:center;justify-content:center;font-size:22px;padding-left:4px}
  .video-poster h3{margin:0;font-weight:400;font-size:20px}
  .video-poster p{margin:0;font-size:13px;color:#c9cbd1;max-width:46ch}
  .cap-note{margin-top:10px;font-size:12px;color:var(--ink-subtle)}
  /* live test */
  .panel{margin-top:30px;background:var(--layer)}
  .row{display:grid;grid-template-columns:1fr 1.5fr;gap:18px}
  @media(max-width:680px){.row{grid-template-columns:1fr}}
  .fld{display:block;font-size:12px;color:var(--ink-muted);margin:0 0 6px}
  input[type=text],input[type=email],input[type=number]{width:100%;padding:11px 12px;
    border:1px solid var(--border-strong);border-radius:0;font-family:var(--sans);font-size:14px;
    color:var(--ink);background:var(--field)}
  input::placeholder{color:var(--placeholder)}
  input:focus{outline:none;border-color:var(--primary);box-shadow:0 0 0 2px rgba(29,78,216,.15)}
  .presets{margin:16px 0 2px;display:flex;flex-wrap:wrap;gap:8px}
  .chip{font-size:11px;border:1px solid var(--border-strong);background:transparent;color:var(--ink-muted);
    border-radius:0;padding:6px 12px;cursor:pointer;font-family:var(--sans)}
  .chip:hover{border-color:var(--primary);color:var(--primary)}
  .actions{display:flex;align-items:center;gap:16px;margin-top:20px;flex-wrap:wrap}
  .safe{display:inline-flex;align-items:center;gap:8px;font-size:13px;color:var(--ink-muted);cursor:pointer}
  .safe input{width:auto;cursor:pointer;accent-color:var(--primary)}
  .tokwrap{margin-left:auto;display:flex;align-items:center;gap:8px}
  .tokwrap input{padding:8px 10px;font-size:13px;width:180px}
  .banner{margin-top:16px;padding:12px 14px;font-size:14px;background:#fdf0ef;color:#912018;
    border-left:3px solid var(--error)}
  .notice{margin-top:16px;padding:12px 14px;font-size:14px;background:#fdf7e7;color:#684e00;
    border-left:3px solid #f1c21b}
  .samplebar{margin-top:16px;padding:12px 14px;font-size:12px;font-weight:600;letter-spacing:.02em;
    background:#fdf7e7;color:#684e00;border-left:3px solid #f1c21b}
  .runmeta{margin-top:26px;font-size:12px;letter-spacing:.04em;text-transform:uppercase}
  .runmeta.live{color:#0e6027}
  .runmeta.sample{color:#8e6a00}
  .summary{margin-top:22px;display:flex;align-items:center;gap:22px;border:1px solid var(--hairline);
    background:var(--field);padding:20px 24px}
  .summary .score{font-weight:300;font-size:40px;min-width:84px;text-align:center;letter-spacing:-1px;
    color:var(--primary);font-variant-numeric:tabular-nums}
  .summary.s0 .score{color:var(--error)} .summary.s1 .score{color:#8e6a00}
  .summary.s2 .score{color:var(--primary)} .summary.s3 .score{color:#0e6027}
  .summary .slab{font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-subtle);margin-bottom:6px}
  .summary .headline{font-weight:400;font-size:19px;line-height:1.3}
  .grid{margin-top:24px;display:grid;gap:16px;grid-template-columns:repeat(auto-fill,minmax(250px,1fr))}
  .tile{display:flex;flex-direction:column;gap:11px;min-height:152px;position:relative}
  .tile.soon{background:var(--canvas);opacity:.75}
  .thead{display:flex;flex-direction:column;gap:3px}
  .tname{font-weight:600;font-size:16px}
  .tsub{margin:0}
  .status{font-weight:600;font-size:13px;display:inline-flex;align-items:center;align-self:flex-start;padding:3px 8px}
  .status.idle,.status.running{color:var(--ink-subtle);padding-left:0}
  .status.named{color:var(--cited-fg);background:var(--cited-bg)}
  .status.missed{color:var(--missing-fg);background:var(--missing-bg)}
  .status.absent{color:var(--ink-muted);background:#e8e6df}
  .status.error{color:var(--partial-fg);background:var(--partial-bg);font-size:12px}
  .meta{margin:0}
  .toggle{align-self:flex-start;background:none;border:0;padding:0 0 1px;cursor:pointer;font-family:var(--sans);
    font-size:13px;color:var(--primary);border-bottom:1px solid var(--hairline)}
  .body{font-size:14px;line-height:1.5;white-space:pre-wrap;max-height:220px;overflow:auto;color:var(--ink-muted);
    background:var(--field);border:1px solid var(--hairline);padding:12px}
  .cites-head{font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-subtle);margin-bottom:5px}
  .cites-list{margin:0;padding-left:18px;display:flex;flex-direction:column;gap:3px}
  .cites-list li{font-size:12.5px;line-height:1.35}
  .cite{color:var(--primary);text-decoration:none;word-break:break-word}
  .cite:hover{text-decoration:underline}
  .soonnote{font-size:13px;color:var(--ink-subtle)}
  .mx-badge{display:inline-flex;align-items:center;gap:6px;font-size:11px;letter-spacing:.06em;
    text-transform:uppercase;color:var(--ink-muted);padding:5px 10px;border:1px solid var(--hairline);align-self:flex-start}
  .mx-badge .dot{width:6px;height:6px;border-radius:50%;background:var(--primary)}
  /* email gate */
  .tile.is-gated .status,.tile.is-gated .meta,.tile.is-gated .toggle,.tile.is-gated .body,.tile.is-gated .cites{
    filter:blur(9px);pointer-events:none;user-select:none}
  .summary.is-gated .score,.summary.is-gated .headline{filter:blur(10px);user-select:none}
  .gatebox{margin-top:22px;border:1px solid var(--primary);background:var(--layer);padding:22px 24px}
  .gatebox h3{margin:0 0 6px;font-weight:600;font-size:17px}
  .gatebox p{margin:0 0 16px;font-size:14px;color:var(--ink-muted)}
  .gate-row{display:grid;grid-template-columns:1fr 1fr 1fr auto;gap:10px;align-items:end}
  @media(max-width:820px){.gate-row{grid-template-columns:1fr}}
  .gate-err{margin-top:10px;font-size:13px;color:var(--error)}
  /* calculator */
  .calc-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:28px}
  @media(max-width:820px){.calc-grid{grid-template-columns:1fr}}
  .calc-cell label{display:flex;flex-direction:column;gap:2px;font-size:13px;color:var(--ink);margin-bottom:7px}
  .calc-cell .letter{font-size:22px;font-weight:600;color:var(--primary);line-height:1}
  .calc-cell .hint{font-size:12px;color:var(--ink-subtle);font-weight:300}
  .calc-out{margin-top:26px;display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
  @media(max-width:820px){.calc-out{grid-template-columns:1fr}}
  .out-card{background:var(--layer);border:1px solid var(--hairline);padding:20px}
  .out-card .olabel{font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-subtle)}
  .out-card .onum{font-size:32px;font-weight:300;letter-spacing:-.5px;margin:8px 0 4px;font-variant-numeric:tabular-nums}
  .out-card .odetail{font-size:12.5px;color:var(--ink-muted);line-height:1.5}
  .formula-echo{margin-top:18px;font-size:13px;color:var(--ink-muted);background:var(--layer);
    border:1px solid var(--hairline);padding:12px 14px;font-variant-numeric:tabular-nums;overflow-x:auto}
  .calc-foot{margin-top:16px;font-size:12px;color:var(--ink-subtle)}
  /* proof */
  .proof-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:28px}
  @media(max-width:820px){.proof-grid{grid-template-columns:1fr}}
  .proof-quote{font-size:17px;line-height:1.5;font-style:italic;border-left:3px solid var(--primary);
    padding-left:16px;margin:14px 0}
  .proof-label{font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-subtle)}
  .proof-links{margin-top:14px;display:flex;gap:18px;flex-wrap:wrap}
  .proof-links a{font-size:14px;color:var(--primary);text-decoration:none;border-bottom:1px solid var(--hairline)}
  .proof-links a:hover{border-color:var(--primary)}
  /* ladder */
  .ladder-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:28px}
  @media(max-width:820px){.ladder-grid{grid-template-columns:1fr}}
  .ladder-step{display:flex;flex-direction:column;gap:10px}
  .ladder-step .rung{font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--primary);font-weight:600}
  .ladder-step h3{margin:0;font-weight:600;font-size:18px}
  .ladder-step p{margin:0;font-size:14px;color:var(--ink-muted);line-height:1.55}
  .roo{margin-top:22px;padding:16px 18px;background:var(--layer);border-left:3px solid var(--primary);
    font-size:14.5px;color:var(--ink)}
  /* method note */
  .method{background:var(--layer);border-top:1px solid var(--hairline);border-bottom:1px solid var(--hairline)}
  .tier-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:26px}
  @media(max-width:820px){.tier-grid{grid-template-columns:1fr}}
  .tier h4{margin:0 0 8px;font-weight:600;font-size:15px}
  .tier p{margin:0;font-size:13.5px;color:var(--ink-muted);line-height:1.55}
  .ground-rules{margin-top:20px;font-size:14px;color:var(--ink-muted);max-width:72ch}
  .stat-cite{margin-top:16px;font-size:13px;color:var(--ink-subtle);line-height:1.6}
  .stat-cite a{color:var(--primary)}
  details.faq{border-bottom:1px solid var(--hairline);padding:14px 0}
  details.faq summary{cursor:pointer;font-weight:500;font-size:15px;list-style:none;display:flex;
    justify-content:space-between;gap:12px}
  details.faq summary::after{content:"+";color:var(--primary);font-weight:400}
  details.faq[open] summary::after{content:"–"}
  details.faq p{margin:10px 0 0;font-size:14px;color:var(--ink-muted);line-height:1.6}
  /* dark band */
  .upsell{background:var(--dark);color:#f4f4f4}
  .upsell .mx-eyebrow{color:#93b4f5}
  .upsell .mx-acc-line{background:#93b4f5}
  .upsell .mx-h2{color:#fff}
  .upsell p{color:#c6c6c6;max-width:54ch;margin:18px 0 28px;font-size:18px}
  /* footer */
  footer{background:var(--canvas);border-top:1px solid var(--hairline);padding:40px 0}
  footer .frow{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:16px}
  footer .fnote{margin-top:18px;color:var(--ink-subtle);font-size:11px;line-height:1.7}
  @media (prefers-reduced-motion: reduce){
    .ticker-track,.ticker-dot{animation:none}
    html{scroll-behavior:auto}
  }
</style>
{#- Organization + FAQPage schema — this page practises what it preaches.
    All strings pass through | dump | safe so autoescaping can't corrupt the JSON. -#}
{%- set faqItems = demo.faq or [
  { "q": "Are these AI answers live or pre-recorded?",
    "a": "Live. Every tile is a fresh call to the engine's official API the moment the test runs — the run stamp shows the exact query time. If the backend is unreachable the page shows clearly-labelled sample data instead, never passed off as live." },
  { "q": "What does the visibility score mean?",
    "a": "It counts how many of the tested answer engines named " + demo.client_name + " in their response to the query, out of the engines queried. It is a per-query spot check, not a market-wide share measurement — the full audit covers a broader query set." },
  { "q": "Is the value calculator a revenue attribution claim?",
    "a": "No. It is a modelled estimate with every coefficient visible and adjustable. Your market size and income figures come from your records — we never guess them — and the influence rate is agreed at kickoff, never asserted." },
  { "q": "How is my actual AI exposure measured?",
    "a": "The eXposure figure in the calculator is measured in your audit: a standard set of buyer-intent queries is run across the engines and a citation is recorded only as a direct link or verbatim quote. The free snapshot gives you a first read." }
] %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://maxifidigital.com/#organization",
      "name": "Maxifi Digital",
      "url": "https://maxifidigital.com",
      "logo": "https://aswhub.maxifidigital.com/images/maxifi-digital-logo-black-transparent.png",
      "description": {{ "Maxifi Digital is a global Answer Engine Optimisation (AEO) consultancy helping organisations get cited by AI answer engines such as ChatGPT, Claude, Gemini, Perplexity and Google AI Overviews." | dump | safe }},
      "sameAs": [ {{ demo.case_links.live_hub | dump | safe }} ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {%- for f in faqItems %}
        {
          "@type": "Question",
          "name": {{ f.q | dump | safe }},
          "acceptedAnswer": { "@type": "Answer", "text": {{ f.a | dump | safe }} }
        }{{ "," if not loop.last }}
        {%- endfor %}
      ]
    }
  ]
}
</script>
</head>
<body>

<header class="c-header"><div class="mx-container"><div class="bar">
  <a class="mx-logo" href="https://maxifidigital.com" target="_blank" rel="noopener">
    <img src="/images/maxifi-digital-logo-black-transparent.png" alt="Maxifi Digital" width="135" height="44" loading="eager">
  </a>
  <a class="mx-btn is-sm" data-cta="header-book" href="{{ demo.booking_url }}" target="_blank" rel="noopener">Book a 30-min audit call</a>
</div></div></header>

{#- §1b · citation ticker (from config) -#}
<div class="ticker" aria-label="AI citation feed">
  <span class="ticker-tag"><span class="ticker-dot"></span>{{ demo.ticker_tag or (demo.client_name + " · AI Visibility") }}</span>
  <div class="ticker-viewport"><div class="ticker-track">
    {%- for set in [1, 2] %}
    <span class="tk-set" {% if set == 2 %}aria-hidden="true"{% endif %}>
      {%- for t in demo.ticker_quotes %}
      <span class="ticker-item"><span class="tk-q">&ldquo;{{ t.quote }}&rdquo;</span>
        {%- if t.cited %}<span class="tk-cite">✓ {{ t.engine }}</span>
        {%- else %}<span class="tk-miss">✗ {{ t.engine }}</span>{% endif %}</span>
      <span class="ticker-sep">◆</span>
      {%- endfor %}
    </span>
    {%- endfor %}
  </div></div>
</div>

{#- §1 · Hero -#}
<section class="hero"><div class="hero-glow" aria-hidden="true"></div><div class="mx-container">
  <span class="sector-chip">{{ demo.sector_label }}</span>
