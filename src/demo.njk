<script>
// Per-prospect config, injected at build time from demos/{slug}.json.
const CFG = {{ demo | dump | safe }};

const LIVE_ENGINES = ["openai", "anthropic", "google", "perplexity", "aio"];
const FREE_ENGINES = ["openai", "anthropic"];   // visible before the email gate
const SAFE_DEFAULT = false;
// Demo-scoped, rotatable token; /demo/probe is proxied server-side to the engine
// backend (see netlify.toml), so no API keys and no cross-origin calls here.
const DEMO_TOKEN = "aw2026-demo-k9td";
const PROBE_URL  = "/demo/probe";

const $ = (s, r=document) => r.querySelector(s);
const $$ = (s, r=document) => Array.from(r.querySelectorAll(s));

/* ── analytics: privacy-respecting, no external calls by default.
   Events land in window.dataLayer (picked up by GTM/GA if ever added) and in
   GoatCounter if its script is present. Events: test_run, gate_pass,
   video_play, calc_use, cta_click. ── */
function mxTrack(name, props){
  try{
    (window.dataLayer = window.dataLayer || []).push(Object.assign({event:name}, props || {}));
    if (window.goatcounter && window.goatcounter.count)
      window.goatcounter.count({ path: name, title: JSON.stringify(props || {}), event: true });
  }catch(e){}
}
document.addEventListener("click", (e) => {
  const a = e.target.closest("[data-cta]");
  if (a) mxTrack("cta_click", { label: a.getAttribute("data-cta") });
});

/* ── §2 explainer video: click-to-load iframe, poster first (static-first) ── */
const EXPLAINER_SRC = CFG.explainer_src || "/demo-assets/visibility-value-explainer.html";
$("#video-poster").addEventListener("click", async () => {
  mxTrack("video_play", { slug: CFG.slug });
  const shell = $("#video-shell"), poster = $("#video-poster");
  try {
    const head = await fetch(EXPLAINER_SRC, { method: "HEAD" });
    if (!head.ok) throw new Error("missing");
  } catch (e) {
    poster.querySelector("h3").textContent = "Explainer coming soon";
    poster.querySelector("p").textContent = "The video walkthrough is being finalised — the calculator below covers the same model, interactively.";
    return;
  }
  const frame = document.createElement("iframe");
  frame.src = EXPLAINER_SRC;
  frame.title = "Visibility Value Model explainer";
  frame.allow = "fullscreen";
  frame.addEventListener("load", () => {
    // Same-origin: rebind the explainer's final "Calculate Your Visibility
    // Value" CTA to scroll to this page's calculator instead of swapping views.
    try {
      const doc = frame.contentDocument;
      $$("a,button", doc).forEach((el) => {
        if (/calculate\s+your\s+visibility\s+value/i.test(el.textContent || "")) {
          el.onclick = null;   // the explainer binds its view-swap via the onclick property
          el.addEventListener("click", (ev) => {
            ev.preventDefault(); ev.stopImmediatePropagation();
            document.getElementById("calculator").scrollIntoView({ behavior: "smooth" });
          }, true);
        }
      });
    } catch (e) {}
  });
  poster.remove();
  shell.appendChild(frame);
});

/* ── §3 live tester — same mechanics as the original single-client demo ── */
const params = new URLSearchParams(location.search);
let urlToken = params.get("token") || "";
if (!urlToken && !DEMO_TOKEN) $("#tokwrap").hidden = false;
function getToken(){ return urlToken || $("#token").value.trim() || DEMO_TOKEN; }

const urlSafe = params.get("safe");
$("#safe").checked = urlSafe != null ? (urlSafe === "1" || urlSafe === "true") : SAFE_DEFAULT;
function syncSampleBar(){ $("#samplebar").hidden = !$("#safe").checked; }
$("#safe").addEventListener("change", syncSampleBar);
syncSampleBar();

function showNotice(msg){ const el = $("#notice"); el.textContent = msg; el.hidden = false; }
function hideNotice(){ const el = $("#notice"); el.textContent = ""; el.hidden = true; }
function showBanner(msg){ const el = $("#banner"); el.textContent = msg; el.hidden = false; }
function hideBanner(){ const el = $("#banner"); el.textContent = ""; el.hidden = true; }
function shorten(s){ s = String(s||""); return s.length > 90 ? s.slice(0,90)+"…" : s; }

(CFG.preset_queries || []).forEach((p) => {
  const b = document.createElement("button");
  b.className = "chip"; b.type = "button"; b.textContent = p;
  b.addEventListener("click", () => { $("#query").value = p; });
  $("#presets").appendChild(b);
});

function tileFor(engine){ return $('.tile[data-engine="'+engine+'"]'); }
function setStatus(tile, kind, label){
  const s = $(".status", tile); s.className = "status " + kind; s.textContent = label;
}
function _domainOf(u){
  try { return new URL(u).hostname.replace(/^www\./, ""); } catch (e){ return String(u); }
}
function renderCites(box, citations){
  box.textContent = "";
  const list = (citations || []).filter(u => typeof u === "string");
  if (!list.length) return;
  const head = document.createElement("div");
  head.className = "cites-head"; head.textContent = "Sources (" + list.length + ")";
  box.appendChild(head);
  const ol = document.createElement("ol"); ol.className = "cites-list";
  list.forEach(u => {
    const li = document.createElement("li");
    const ok = /^https?:\/\//i.test(u);
    const el = document.createElement(ok ? "a" : "span");
    el.className = "cite"; el.textContent = _domainOf(u);
    if (ok){ el.href = u; el.target = "_blank"; el.rel = "noopener noreferrer"; el.title = u; }
    li.appendChild(el); ol.appendChild(li);
  });
  box.appendChild(ol);
}
function resetTile(tile){
  setStatus(tile, "running", "Asking…");
  $(".meta", tile).textContent = "";
  const body = $(".body", tile); body.hidden = true; body.textContent = "";
  $(".cites", tile).textContent = "";
  $(".toggle", tile).hidden = true;
}
function renderTile(engine, d){
  const tile = tileFor(engine); if (!tile) return;
  const meta = $(".meta", tile), body = $(".body", tile);
  const cites = $(".cites", tile), toggle = $(".toggle", tile);
  body.textContent = ""; cites.textContent = ""; meta.textContent = "";
  body.hidden = true; toggle.hidden = true;
  if (!d || (!d.ok && d.error)){
    setStatus(tile, "error", "⚠ " + shorten(d && d.error ? d.error : "Unavailable"));
    if (d && d.ms) meta.textContent = d.ms + " ms";
    return;
  }
  if (d.named){ setStatus(tile, "named", "✓ Cited"); }
  else if (d.present === false && engine === "aio"){ setStatus(tile, "absent", "— No AI Overview"); }
  else { setStatus(tile, "missed", "✗ Not cited"); }
  meta.textContent = (d.model || engine) + " · " + (d.ms || 0) + " ms" + (d.sample ? " · sample" : "");
  body.textContent = d.verbatim_response || "(empty response)";
  renderCites(cites, d.citations);
  if (d.verbatim_response){ toggle.hidden = false; toggle.textContent = "Show response"; }
}
$("#grid").addEventListener("click", (e) => {
  if (!e.target.classList.contains("toggle")) return;
  const body = $(".body", e.target.closest(".tile"));
  body.hidden = !body.hidden;
  e.target.textContent = body.hidden ? "Show response" : "Hide response";
});
function renderSummary(named, total, brand){
  const el = $("#summary"); el.hidden = false;
  $("#score").textContent = named + " / " + total;
  let cls, msg;
  if (named === 0){ cls = "s0"; msg = "Invisible — not one engine cited " + brand + ". This is the gap."; }
  else if (named <= total/2){ cls = "s1"; msg = "Barely visible — AI cites " + brand + " on only " + named + " of " + total + " engines."; }
  else if (named < total){ cls = "s2"; msg = "Partial visibility — AI cites " + brand + " on some engines but misses you on others."; }
  else { cls = "s3"; msg = "Strong visibility — every engine cited " + brand + ". Now defend that lead."; }
  el.classList.remove("s0","s1","s2","s3"); el.classList.add(cls);
  $("#headline").textContent = msg;
}
function setRunMeta(sample){
  const el = $("#runmeta");
  if (sample){ el.className = "runmeta sample"; el.textContent = "Sample data — illustrative, not a live run."; }
  else {
    const ts = new Date().toISOString().replace("T", " ").slice(0, 19) + " UTC";
    el.className = "runmeta live"; el.textContent = "● LIVE · queried " + ts;
  }
  el.hidden = false;
}

/* ── email gate: 2 engines free; the rest + the score blur until the form
   passes. Passing persists in localStorage so returning visitors stay open. ── */
const GATE_KEY = "mx-demo-gate-passed";
function gatePassed(){ try { return localStorage.getItem(GATE_KEY) === "1"; } catch(e){ return false; } }
function applyGate(){
  if (gatePassed()) return;
  $$(".tile[data-gated]").forEach(t => t.classList.add("is-gated"));
  $("#summary").classList.add("is-gated");
  $("#gatebox").hidden = false;
}
function liftGate(){
  $$(".tile[data-gated]").forEach(t => t.classList.remove("is-gated"));
  $("#summary").classList.remove("is-gated");
  $("#gatebox").hidden = true;
}
$("#gate-form").addEventListener("submit", async (e) => {
  e.preventDefault();
  const btn = $("#gate-submit"), err = $("#gate-err");
  err.hidden = true; btn.disabled = true; btn.textContent = "Sending…";
  const data = new URLSearchParams(new FormData(e.target));
  data.set("brand", $("#brand").value.trim());
  data.set("query", $("#query").value.trim());
  let delivered = false;
  try {
    const res = await fetch("/", { method: "POST",
      headers: { "Content-Type": "application/x-www-form-urlencoded" }, body: data.toString() });
    delivered = res.ok;
  } catch (e) {}
  // Unlock either way — a form-endpoint hiccup shouldn't strand a prospect —
  // but tell them if the email copy didn't go through.
  try { localStorage.setItem(GATE_KEY, "1"); } catch (e) {}
  mxTrack("gate_pass", { slug: CFG.slug, delivered });
  liftGate();
  if (!delivered){
    showNotice("Results unlocked. The emailed copy could not be sent just now — book a call or use the snapshot link and we'll send it manually.");
  }
  btn.disabled = false; btn.textContent = "Email me the full result";
});

/* ── run ── */
async function probeEngine(engine, payload){
  const res = await fetch(PROBE_URL, {
    method: "POST",
    headers: { "Content-Type": "application/json", "X-Demo-Token": payload.token || "" },
    body: JSON.stringify({ brand: payload.brand, query: payload.query, engine, token: payload.token, safe: payload.safe })
  });
  if (res.status === 401){ const e = new Error("auth"); e.code = 401; throw e; }
  if (!res.ok){ throw new Error("http " + res.status); }
  return res.json();
}
async function run(){
  hideBanner(); hideNotice();
  $("#runmeta").hidden = true;
  const brand = $("#brand").value.trim();
  const query = $("#query").value.trim();
  const token = getToken();
  const safe = $("#safe").checked;
  if (!brand || !query){ showBanner("Enter a brand name and a query."); return; }
  if (!token){ showBanner("Enter the demo access token to run live tests."); return; }
  mxTrack("test_run", { slug: CFG.slug, safe });

  const btn = $("#run"); btn.disabled = true; btn.textContent = "Running…";
  $("#summary").hidden = true;
  LIVE_ENGINES.forEach(e => { const t = tileFor(e); if (t) resetTile(t); });

  let auth = false, capped = false, capMsg = "", sample = false, named = 0;
  const settled = await Promise.all(LIVE_ENGINES.map(async (engine) => {
    try { return { engine, d: await probeEngine(engine, { brand, query, token, safe }) }; }
    catch (err){ return { engine, err }; }
  }));
  settled.forEach(({ engine, d, err }) => {
    if (err){
      if (err.code === 401) auth = true;
      renderTile(engine, { ok:false, error: err.code === 401 ? "Invalid demo token" : "Network error" });
      return;
    }
    if (d.capped){ capped = true; capMsg = d.error; }
    if (d.sample){ sample = true; }
    renderTile(engine, d);
    if (d.ok && d.named) named++;
  });

  if (auth){ showBanner("Invalid or missing demo token — check your link."); }
  else if (capped){ showBanner(capMsg || "Daily demo budget reached."); }
  else { renderSummary(named, LIVE_ENGINES.length, brand); setRunMeta(sample); applyGate(); }
  if (sample){ showNotice("Safe demo mode — illustrative sample data, not live engine results."); $("#samplebar").hidden = false; }

  btn.disabled = false; btn.textContent = "Run visibility test";
  const okCount = settled.filter(s => s.d && s.d.ok).length;
  return { okCount, auth, capped };
}
$("#run").addEventListener("click", run);
$("#query").addEventListener("keydown", (e) => { if (e.key === "Enter") run(); });
$("#brand").addEventListener("keydown", (e) => { if (e.key === "Enter") run(); });

/* Clearly-labelled illustrative fallback if the backend is unreachable —
   generic wording only; never presented as a live result. */
function renderSample(){
  hideBanner();
  const brand = $("#brand").value.trim() || "the brand";
  renderSummary(2, 5, brand);
  setRunMeta(true);
  showNotice("Illustrative sample — the live engine backend was unreachable, so these are example results, not a live run.");
  $("#samplebar").hidden = false;
  renderTile("openai",{ok:true,named:true,model:"sample",ms:1180,citations:[],
    verbatim_response:"[Illustrative sample] An engine response naming " + brand + " would appear here, word for word."});
  renderTile("anthropic",{ok:true,named:false,present:true,model:"sample",ms:1520,citations:[],
    verbatim_response:"[Illustrative sample] A response that fails to mention " + brand + " would appear here — that's the gap this page measures."});
  renderTile("google",{ok:false,ms:870,error:"sample: backend unreachable"});
  renderTile("perplexity",{ok:true,named:true,model:"sample",ms:1340,
    citations:[CFG.case_links && CFG.case_links.live_hub ? CFG.case_links.live_hub : "https://maxifidigital.com"],
    verbatim_response:"[Illustrative sample] A cited response with live source links would appear here."});
  renderTile("aio",{ok:true,named:false,present:false,model:"AI Overviews",ms:980,citations:[],verbatim_response:""});
  applyGate();
}
// One real run on load so the first view is genuine engine output — skipped when
// the config ships no default brand (e.g. the generic /demo/b2b page), so the
// generic page never spends engine budget by itself.
async function autoRun(){
  if (!(CFG.brand_default || "").trim() || !(CFG.query_default || "").trim()) return;
  try { const r = await run(); if (!r || r.auth || r.okCount === 0) renderSample(); }
  catch (e) { renderSample(); }
}
autoRun();

/* ── §4 MAXIFI calculator — seeded from config value_defaults ── */
const V = CFG.value_defaults || {};
const CUR = CFG.currency_symbol || "$";
const seed = {
  m: V.M != null ? V.M : 100,
  a: (V.A != null ? V.A : 0.5) * 100,
  x: (V.X != null ? V.X : 0.05) * 100,
  i1: (V.I_influence != null ? V.I_influence : 0.05) * 100,
  f: (V.F != null ? V.F : 1) * 100,
  i2: V.I_income != null ? V.I_income : 20000,
  xc: (V.X_comp != null ? V.X_comp : 0.5) * 100,
  fee: V.fee != null ? V.fee : 4500
};
Object.entries(seed).forEach(([k, v]) => { $("#c-" + k).value = v; });

function money(n){
  return CUR + Math.round(n).toLocaleString("en-GB");
}
let calcUsed = false;
function calc(){
  const n = (id) => { const v = parseFloat($("#c-" + id).value); return isFinite(v) ? Math.max(v, 0) : 0; };
  const M = n("m"), A = n("a")/100, X = Math.min(n("x")/100, 1), I1 = n("i1")/100,
        F = n("f")/100, I2 = n("i2"), XC = Math.min(n("xc")/100, 1), FEE = n("fee");

  const value = M * A * X * I1 * F * I2;
  const gap = Math.max(XC - X, 0);
  const risk = M * A * gap * I1 * F * I2;

  $("#formula-echo").textContent =
    "M " + M.toLocaleString("en-GB") + " × A " + (A*100).toFixed(0) + "% × X " + (X*100).toFixed(0) +
    "% × I " + (I1*100).toFixed(0) + "% × F " + (F*100).toFixed(0) + "% × I " + money(I2) +
    " = " + money(value) + " influenced value / year";
  $("#out-value").textContent = money(value) + "/yr";
  $("#out-risk").textContent = money(risk) + "/yr";
  $("#out-risk-detail").textContent = gap > 0
    ? "Citation gap of " + (gap*100).toFixed(0) + " points between competitor exposure (" + (XC*100).toFixed(0) + "%) and yours (" + (X*100).toFixed(0) + "%)."
    : "No citation gap at these settings — your exposure meets or beats the competitor figure.";

  if (I2 > 0 && risk > 0){
    const decisions = FEE / I2;
    const pct = (FEE / risk) * 100;
    $("#out-breakeven").textContent = decisions.toFixed(2) + " decisions";
    $("#out-breakeven-detail").textContent =
      "The fee of " + money(FEE) + " equals " + decisions.toFixed(2) + " of one decision — and " +
      pct.toFixed(0) + "% of the revenue at risk each year.";
  } else if (risk <= 0){
    $("#out-breakeven").textContent = "—";
    $("#out-breakeven-detail").textContent = "No citation gap at these settings — there is no at-risk revenue to break even against.";
  } else {
    $("#out-breakeven").textContent = "—";
    $("#out-breakeven-detail").textContent = "Set the value of one decision to model break-even.";
  }
}
$$("input[id^='c-']").forEach((el) => el.addEventListener("input", () => {
  if (!calcUsed){ calcUsed = true; mxTrack("calc_use", { slug: CFG.slug }); }
  calc();
}));
calc();
</script>
