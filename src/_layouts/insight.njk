---
layout: base.njk
---

<header class="page-header">
  <div class="container">
    <p class="eyebrow">Insight · {{ date | readableDate }}</p>
    <h1>{{ title }}</h1>
    <p>{{ summary }}</p>
  </div>
</header>

<section>
  <div class="container">
    <article class="prose">
      {{ content | safe }}
    </article>
  </div>
</section>

<section class="section-tight" style="border-bottom: 0;">
  <div class="container">
    <div class="maxifi-cta">
      <div>
        <p class="eyebrow">More analysis</p>
        <h2>All ASW 2026 insights</h2>
        <p>Briefings, retrospectives, and operational analysis published in the run-up to and following Airspace World 2026.</p>
      </div>
      <div class="maxifi-cta-actions">
        <a class="btn btn-primary" href="/insights/">All insights →</a>
        <a class="btn btn-ghost" href="/themes/">Browse themes</a>
      </div>
    </div>
  </div>
</section>
