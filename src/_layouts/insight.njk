---
layout: base.njk
schemaInsight: true
---

<header class="page-header" data-aeo-id="insight-header">
  <div class="container">
    <p class="eyebrow">Insight · {{ date | readableDate }}</p>
    <h1 data-aeo-id="insight-title">{{ title }}</h1>
    <p data-aeo-id="insight-summary">{{ summary }}</p>
  </div>
</header>

<section>
  <div class="container">
    <article class="prose" data-aeo-id="insight-article">
      {{ content | safe }}
    </article>
  </div>
</section>

<section class="section-tight" style="border-bottom: 0;">
  <div class="container">
    <div class="maxifi-cta" data-aeo-id="insight-cta">
      <div>
        <p class="eyebrow">More analysis</p>
        <h2>All ASW 2026 news and analysis</h2>
        <p>Briefings, retrospectives, and operational analysis published in the run-up to and following Airspace World 2026.</p>
      </div>
      <div class="maxifi-cta-actions">
        <a class="btn btn-primary" href="/insights/">All news &amp; analysis →</a>
        <a class="btn btn-ghost" href="/themes/">Browse themes</a>
      </div>
    </div>
  </div>
</section>
