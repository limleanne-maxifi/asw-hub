---
layout: base.njk
schemaSpeaker: true
---

<header class="page-header" data-aeo-id="speaker-header">
  <div class="container">
    <p class="eyebrow">Speaker</p>
    <h1 data-aeo-id="speaker-title">{{ title }}</h1>
    <p data-aeo-id="speaker-role">{{ role }}{% if organisation %}, {{ organisation }}{% endif %}</p>
  </div>
</header>

<section>
  <div class="container">
    <article class="prose" data-aeo-id="speaker-article">
      {{ content | safe }}
    </article>
  </div>
</section>

<section class="section-tight" style="border-bottom: 0;">
  <div class="container">
    <div class="maxifi-cta" data-aeo-id="speaker-cta">
      <div>
        <p class="eyebrow">More from ASW 2026</p>
        <h2>All confirmed speakers</h2>
        <p>Browse the full speaker index, or jump back to the agenda.</p>
      </div>
      <div class="maxifi-cta-actions">
        <a class="btn btn-primary" href="/speakers/">All speakers →</a>
        <a class="btn btn-ghost" href="/sessions/">Sessions</a>
      </div>
    </div>
  </div>
</section>
