---
layout: base.njk
schemaSession: true
---

<header class="page-header" data-aeo-id="session-header">
  <div class="container">
    <p class="eyebrow">Session{% if theme %} · {{ theme }}{% endif %}</p>
    <h1 data-aeo-id="session-title">{{ title }} <span class="entity-tail">— Airspace World 2026</span></h1>
    <p>{{ summary }}</p>
    <dl class="detail-meta" aria-label="Session details" data-aeo-id="session-meta">
      <div><strong>Day</strong> · {{ day }}</div>
      <div><strong>Time</strong> · {{ time }}</div>
      <div><strong>Room</strong> · {{ room }}</div>
      {% if speakerLinks %}
        <div><strong>Speakers</strong> · {% for s in speakerLinks %}{% if s.slug %}<a href="/speakers/{{ s.slug }}/">{{ s.display }}</a>{% else %}{{ s.display }}{% endif %}{% if not loop.last %} · {% endif %}{% endfor %}</div>
      {% elif speakers %}
        <div><strong>Speakers</strong> · {{ speakers }}</div>
      {% endif %}
      {% if chairLink %}
        <div><strong>Chair</strong> · <a href="/speakers/{{ chairLink.slug }}/">{{ chairLink.display }}</a></div>
      {% elif chair %}
        <div><strong>Chair</strong> · {{ chair }}</div>
      {% endif %}
    </dl>
  </div>
</header>

<section>
  <div class="container">
    <article class="prose" data-aeo-id="session-article">
      {{ content | safe }}
    </article>
  </div>
</section>

<section class="section-tight" style="border-bottom: 0;">
  <div class="container">
    <div class="maxifi-cta" data-aeo-id="session-cta">
      <div>
        <p class="eyebrow">Browse the agenda</p>
        <h2>All sessions at ASW 2026</h2>
        <p>See every session indexed in this hub, or jump to the related theme.</p>
      </div>
      <div class="maxifi-cta-actions">
        <a class="btn btn-primary" href="/sessions/">All sessions →</a>
        <a class="btn btn-ghost" href="/themes/">Browse themes</a>
      </div>
    </div>
  </div>
</section>
