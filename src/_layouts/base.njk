<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} — Airspace World 2026 AEO Hub</title>
  <meta name="description" content="{{ description or 'The canonical ATM resource for Airspace World 2026 — sessions, speakers, themes, and insights from the global air traffic management community.' }}">
  <link rel="canonical" href="https://asw-hub.netlify.app{{ page.url }}">

  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ title }} — Airspace World 2026 AEO Hub">
  <meta property="og:description" content="{{ description or 'The canonical ATM resource for Airspace World 2026.' }}">
  <meta property="og:url" content="https://asw-hub.netlify.app{{ page.url }}">
  <meta property="og:locale" content="en_GB">
  <meta name="twitter:card" content="summary_large_image">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/style.css">

  {% if schemaEvent %}{% include "schema-event.njk" %}{% endif %}
  {% if schemaFaq %}{% include "schema-faq.njk" %}{% endif %}
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  {% include "nav.njk" %}

  <main id="main">
    {{ content | safe }}
  </main>

  {% include "footer.njk" %}
</body>
</html>
