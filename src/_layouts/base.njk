<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} — Airspace World 2026: AI Visibility Hub</title>
  <meta name="description" content="{{ description or 'The canonical ATM resource for Airspace World 2026 — sessions, speakers, themes, and insights from the global air traffic management community.' }}">
  <link rel="canonical" href="https://aswhub.maxifidigital.com{{ page.url }}">

  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ title }} — Airspace World 2026: AI Visibility Hub">
  <meta property="og:description" content="{{ description or 'The canonical ATM resource for Airspace World 2026.' }}">
  <meta property="og:url" content="https://aswhub.maxifidigital.com{{ page.url }}">
  <meta property="og:image" content="https://aswhub.maxifidigital.com/images/og-image.svg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:locale" content="en_GB">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content="https://aswhub.maxifidigital.com/images/og-image.svg">
  <meta name="msvalidate.01" content="1F14880D43A6A0045A2FDA30B5BDA3B0">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/style.css">

  {% include "schema-site.njk" %}
  {% include "schema-breadcrumb.njk" %}
  {% if schemaEvent %}{% include "schema-event.njk" %}{% endif %}
  {% if schemaFaq %}{% include "schema-faq.njk" %}{% endif %}
  {% if schemaSession %}{% include "schema-session.njk" %}{% endif %}
  {% if schemaSpeaker %}{% include "schema-speaker.njk" %}{% endif %}
  {% if schemaInsight %}{% include "schema-insight.njk" %}{% endif %}
  {% if schemaHowTo %}{% include "schema-howto.njk" %}{% endif %}
  <link rel="stylesheet" href="/assets/css/layers.css">
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  {% include "nav.njk" %}

  <main id="main">
    {{ content | safe }}
  </main>

  {% include "footer.njk" %}
  <script src="/assets/js/aeo-inspector.js" defer></script>
</body>
</html>
